<!-- 
  Landing page with three architectural pillars (IIE, 2026).
-->
<ContentPage
    x:Class="SmartX.Maui.Pages.LandingPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Smart-X Gateway"
    BackgroundColor="#f5f7fa">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20">

            <!-- Page header (IIE, 2026). -->
            <Label
                Text="Smart-X IoT Gateway"
                FontSize="32"
                FontAttributes="Bold"
                TextColor="#1F4E79"
                HorizontalOptions="Center" />

            <Label
                Text="Distributed Environment Monitoring &amp; Management"
                FontSize="14"
                TextColor="#6c757d"
                HorizontalOptions="Center"
                Margin="0,0,0,10" />

            <!-- Quick navigation between the active views (IIE, 2026). -->
            <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="Center"
                        Margin="0,0,0,10">
                <Button Text="Register Sensors"
                        Clicked="OnRegisterNavClicked"
                        Margin="5"
                        BackgroundColor="#1F4E79" TextColor="White" />
                <Button Text="Live Telemetry Dashboard"
                        Clicked="OnDashboardTapped"
                        Margin="5"
                        BackgroundColor="#ffffff" TextColor="#1F4E79"
                        BorderColor="#1F4E79" BorderWidth="1" />
            </FlexLayout>

            <!-- Pillar 1: Sensor Data Ingestion (ACTIVE) (IIE, 2026). -->
            <Border
                Stroke="#1F4E79"
                StrokeThickness="2"
                BackgroundColor="White"
                Padding="20"
                StrokeShape="RoundRectangle 12">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSensorIngestionTapped" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="10">
                    <Label Text="📡" FontSize="48" HorizontalOptions="Center" />
                    <Label Text="Sensor Data Ingestion" FontSize="18" FontAttributes="Bold"
                           HorizontalOptions="Center" TextColor="#333" />
                    <Label Text="Register sensors and receive live telemetry"
                           FontSize="12" TextColor="#666" HorizontalOptions="Center" />
                    <Border BackgroundColor="#D5E8D4" Padding="10,4"
                            HorizontalOptions="Center" StrokeThickness="0"
                            StrokeShape="RoundRectangle 20">
                        <Label Text="ACTIVE" FontSize="10" FontAttributes="Bold"
                               TextColor="#2e7d32" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Pillar 2: Real-Time Command Stream (LOCKED) (IIE, 2026). -->
            <Border
                Stroke="#e0e0e0"
                StrokeThickness="2"
                BackgroundColor="White"
                Padding="20"
                Opacity="0.5"
                StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="10">
                    <Label Text="⚡" FontSize="48" HorizontalOptions="Center" />
                    <Label Text="Real-Time Command Stream" FontSize="18" FontAttributes="Bold"
                           HorizontalOptions="Center" TextColor="#333" />
                    <Label Text="Issue manual override commands"
                           FontSize="12" TextColor="#666" HorizontalOptions="Center" />
                    <Border BackgroundColor="#e0e0e0" Padding="10,4"
                            HorizontalOptions="Center" StrokeThickness="0"
                            StrokeShape="RoundRectangle 20">
                        <Label Text="PART 2" FontSize="10" FontAttributes="Bold"
                               TextColor="#616161" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Pillar 3: Network Topology (LOCKED) (IIE, 2026). -->
            <Border
                Stroke="#e0e0e0"
                StrokeThickness="2"
                BackgroundColor="White"
                Padding="20"
                Opacity="0.5"
                StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="10">
                    <Label Text="🌐" FontSize="48" HorizontalOptions="Center" />
                    <Label Text="Network Topology &amp; Mesh Routing" FontSize="18"
                           FontAttributes="Bold" HorizontalOptions="Center" TextColor="#333" />
                    <Label Text="Visualise mesh network and routing paths"
                           FontSize="12" TextColor="#666" HorizontalOptions="Center" />
                    <Border BackgroundColor="#e0e0e0" Padding="10,4"
                            HorizontalOptions="Center" StrokeThickness="0"
                            StrokeShape="RoundRectangle 20">
                        <Label Text="FINAL PoE" FontSize="10" FontAttributes="Bold"
                               TextColor="#616161" />
                    </Border>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
